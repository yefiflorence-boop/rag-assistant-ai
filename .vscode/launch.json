{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "justMyCode": false
    },
    {
      "name": "Debug script RAG (src/test.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\test.py",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
